{
  "name": "scdp-painel",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "description": "Painel local SCDP — execução, viagens e bilhetes",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --open /dev.html",
    "build": "node scripts/compilar.mjs",
    "build:pages": "node scripts/compilar.mjs --pages",
    "preparar": "node scripts/preparar.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "start": "node scripts/iniciar.mjs",
    "update-data": "node scripts/atualizar_dados.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "docx": "^9.5.0",
    "echarts": "^6.0.0",
    "fflate": "0.8.3",
    "jspdf": "^3.0.0",
    "jspdf-autotable": "^5.0.0",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
